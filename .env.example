# ==========================================
# Soil Mates Full-Stack Environment Variables
# ==========================================

# Server & Runtime Configuration
PORT=3000
BACKEND_PORT=4000
NODE_ENV=development

# Database Configuration (MongoDB)
# If left empty, resilient in-memory hybrid store is automatically used
MONGODB_URI=mongodb://localhost:27017/soilmates
MONGODB_DB=soilmates

# Authentication Security Secret (JWT)
AUTH_SECRET=soil-mates-super-secret-jwt-key-2026

# Google Gemini API Key for Server-Side AI Crop Doctor
# Configured via AI Studio secrets or environment
GEMINI_API_KEY=

# CORS Configuration
CORS_ORIGIN=*

# Frontend API Base URL (leave empty for same-origin proxy)
VITE_API_BASE_URL=

