# ==========================================
# Soil Mates Standalone Backend Configuration
# ==========================================

# Server Network Port
PORT=4000
NODE_ENV=development

# MongoDB Connection String
# e.g. local: mongodb://localhost:27017/soilmates
# e.g. docker: mongodb://mongodb:27017/soilmates
# e.g. atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/soilmates
MONGODB_URI=mongodb://localhost:27017/soilmates
MONGODB_DB=soilmates

# Google Gemini API Key for AI Crop Doctor
# Used server-side via @google/genai SDK
GEMINI_API_KEY=

# JSON Web Token Secret Key
AUTH_SECRET=soil-mates-super-secret-jwt-key-2026

# Allowed CORS Origins
CORS_ORIGIN=*
